# The site works from JSON already committed under public/data/.
# To let a build re-pull the sheet you must supply the id — it is NOT stored
# in this repo because the sheet contains student PII.
#
#  • CI:    add these as GitHub Actions repo secrets
#  • Local: create sheet.config.json (gitignored):
#           { "SHEET_ID": "...", "SHEET_RECORDS_GID": "0", "SHEET_FUNDS_GID": "..." }

SHEET_ID=
SHEET_RECORDS_GID=0
SHEET_FUNDS_GID=

# --- Facebook auto-fetch for Announcements (optional) ---
FB_PAGE_ID=107473958961394
FB_PAGE_TOKEN=
# FB_POST_LIMIT=8
# FB_SCRAPE=1   # best-effort token-free scrape — Facebook usually blocks it (HTTP 400)

# --- Firebase (optional) — enables the realtime Members roster ---
# From Firebase console ▸ Project settings ▸ Your apps ▸ SDK config.
# These are NOT secrets (they identify the project); real protection is in
# firestore.rules. Leave blank to hide the Members section entirely.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Apps Script read API (optional) ---
# URL is used ONLY for the per-student record lookup by default. The dashboard
# totals render from the bundled aggregates (no Network request) unless you set
# FEATURES.liveSummary = true in src/data/site.ts.
VITE_APPS_SCRIPT_URL=
# Must equal the TX_READ_KEY script property on the Apps Script side.
VITE_APPS_SCRIPT_KEY=

# --- Cloudflare Turnstile for the record lookup (optional, off by default) ---
# Free bot-check on the one route that returns per-student PII. No domain/DNS
# change needed — sign up at dash.cloudflare.com/?to=/:account/turnstile,
# create a widget for this site's origin, then set this AND the matching
# TX_TURNSTILE_SECRET script property on the Apps Script side (see
# apps-script/Code.gs). Leave blank to disable — lookups work as before.
VITE_TURNSTILE_SITE_KEY=

# --- Browser CSV lookup fallback (OFF by default — security sensitive) ---
# Setting this publishes the spreadsheet id in the built JS and needs the sheet
# on "Anyone with the link can view", which lets anyone query every row. Only
# set it if the sheet contains NO data you wouldn't hand to any student.
# Prefer leaving it blank and serving all reads through the Apps Script.
VITE_LOOKUP_SHEET_ID=
VITE_LOOKUP_SHEET_GID=0
